[Unit]
Description=Liquid AI LFM3 1.7B NVFP4 (vLLM nightly), OpenAI+Anthropic API :__PORT__
Wants=network-online.target
Requires=docker.service
# One engine at a time on this box, said to systemd: starting this lane stops the others
# and starting another stops this one, the stop finishing before the start in both
# directions (Conflicts= alone orders nothing, hence After= on the same units).
Conflicts=qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-flash-unsloth.service qwen38-image-h3.service qwen38-transcribe.service qwen38-lfm25.service qwen38-inkling.service
After=network-online.target docker.service qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-flash-unsloth.service qwen38-image-h3.service qwen38-transcribe.service qwen38-lfm25.service qwen38-inkling.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-lfm3
# The memory the last engine held has to be back before this one starts (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-lfm3.service
# The key goes to the server in the file SGLang's lanes read too (see engine-secrets.sh): vLLM
# reads the same YAML with --config and merges it in memory, so the key is on no command line,
# and its "non-default args" log line prints api_key as *** (vllm/entrypoints/common/startup.py of
# this image, _SENSITIVE_ARG_FIELDS).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-secrets.sh
# Liquid AI's LFM3 1.7B in its official NVFP4 build (ModelOpt, weights and activations by groups of 16), served by
# vLLM's own nightly image: LFM3 came to vLLM on 2026-11-06 (PR 65826), in no release yet. As the reference box
# measured it on 2026-11-16, before the share below was set (~/qa-tools/etudes/lfm3-vllm/NOTES.md): ready in 160 s at
# its first boot (127 s of engine init), its NVFP4 read by FlashInfer, the model's whole window of 262,144 tokens,
# GSM8K 250 at 0.896, 87.7 tokens/s alone and 3,912 in all at 128 requests, an agent's next turn served 99 to 100 %
# from the prefix cache from its second turn.
#   --gpu-memory-utilization __GMU__ (LFM3_GMU, install-lfm3.sh): this nightly sizes its KV cache after the warmup and
#     extends it into every byte free (v1/worker/extensible_kv_cache.py, which says to set it "on a unified-memory
#     device"): with nothing set, the box kept 1,087 MiB available at its lowest under load. A share caps it.
#   --reasoning-parser qwen3 and --tool-call-parser qwen3_coder: its template writes a thought between <think> and
#     </think>, and its calls in Qwen3-Coder's form (<tool_call><function=...><parameter=...>), read by these two
#     parsers into reasoning_content and OpenAI tool calls (measured: both, a call streamed, its result's turn).
#   The checkpoint's own chat template, as published: it reads enable_thinking (true by default) and no effort.
#   The prefix cache at vLLM's own setting for this hybrid model (its short convolutions keep a state, aligned to the
#     cache's blocks): measured 99 to 100 % of an agent's next turn served from it.
# The sampling defaults (temperature 0.1, top_k 50, repetition_penalty 1.1) are the checkpoint's
# generation_config.json, which vLLM applies to any request that does not set them.
# Its own caches, so that a boot after the first builds nothing again: vLLM's compile cache and FlashInfer's kernels
# (the NVFP4 GEMM's tuning at the first boot) and Triton's.
# PYTHONDONTWRITEBYTECODE and HF_MODULES_CACHE: nothing root-owned lands in the user's HF cache (the checkpoint ships
# its own modelling code, which vLLM does not run: it serves Lfm3ForCausalLM natively).
# VLLM_NO_USAGE_STATS and DO_NOT_TRACK: vLLM reports anonymous usage to its authors by default; a box that serves its
# owner's data sends nothing anywhere.
# Of the config directory, the two files the engine reads, read-only, and nothing else: the key's YAML (--config) and
# the key itself (the middleware's). --mount, not -v: a source that is not there fails the start, where -v made a
# directory in its place, owned by root.
# vllm_engine_auth.RequireKey: vLLM checks the key only under /v1, /v2, /inference and /cohere (GUARDED_PREFIX of this
# image's vllm/entrypoints/serve/middleware/authenticate.py); the middleware asks it everywhere but /health and
# /metrics, as the SGLang lanes do. /metrics stays open with --api-key in this image, as the cockpit and the proxy
# read it.
# --enable-prompt-tokens-details: each answer says how much of its prompt the prefix cache served
# (usage.prompt_tokens_details.cached_tokens, and cache_read_input_tokens beside input_tokens on
# /v1/messages, input_tokens then counting the rest), which the engine counts anyway: discussion #49.
ExecStart=/bin/bash -c '/usr/bin/docker run --rm --name qwen38-lfm3 --gpus all \
  --memory 100g --memory-swap 100g --shm-size 16g --network host --ipc=host \
  -e HF_HUB_OFFLINE=1 -e VLLM_NO_USAGE_STATS=1 -e DO_NOT_TRACK=1 \
  -e PYTHONDONTWRITEBYTECODE=1 -e HF_MODULES_CACHE=/tmp/hf-modules \
  -e PYTHONPATH=/opt/qwen38-auth -e QWEN38_KEY_FILE=/out/api-key \
  -v __HOME__/.config/qwen38/lfm3-cache/vllm:/root/.cache/vllm \
  -v __HOME__/.config/qwen38/lfm3-cache/flashinfer:/root/.cache/flashinfer \
  -v __HOME__/.config/qwen38/lfm3-cache/triton:/root/.triton \
  -v __HF_CACHE__:/root/.cache/huggingface \
  --mount type=bind,source=__HOME__/.config/qwen38/api-key,target=/out/api-key,readonly \
  --mount type=bind,source=__HOME__/.config/qwen38/engine-secrets.yaml,target=/out/engine-secrets.yaml,readonly \
  -v __HOME__/.config/qwen38/vllm-auth:/opt/qwen38-auth:ro \
  __IMAGE__ \
    __MODEL__ --revision __REV__ \
    --served-model-name lfm3-1.7b \
    --max-model-len 262144 --gpu-memory-utilization __GMU__ \
    --reasoning-parser qwen3 --tool-call-parser qwen3_coder --enable-auto-tool-choice \
    --enable-prompt-tokens-details \
    --config /out/engine-secrets.yaml --middleware vllm_engine_auth.RequireKey \
    --host __ENGINE_BIND__ --port __PORT__ \
  || { rc=$$?; [ -e "$$RUNTIME_DIRECTORY/stopping" ] && exit 143; exit $$rc; }'
ExecStop=-/bin/bash -c 'touch "$$RUNTIME_DIRECTORY/stopping"'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-lfm3
Restart=always
# docker stops vLLM with SIGTERM (143) or SIGKILL (137) on a plain stop: a clean stop, not a failure.
# A stop while the engine loads: vLLM turns the SIGTERM into KeyboardInterrupt("terminated") until it
# serves and, PID 1 in its container, exits 1, which left the unit failed after a plain stop (the
# reference box, 2026-11-13). The stop marks itself first, in the unit's runtime directory (systemd
# removes it each time the unit stops, a restart of its own included), and ExecStart, which waits
# on docker run where it exec'ed it, exits 143 for a stop it was asked, whatever the engine's code,
# else with docker run's: a crash stays a failure, started again (the other vLLM lanes' rule).
SuccessExitStatus=137 143
RuntimeDirectory=qwen38-lfm3
RestartSec=15

[Install]
WantedBy=multi-user.target
